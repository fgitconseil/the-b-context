---
/* Home — Teaser FAQ. Questions et réponses : nouvelle FAQ, _chantier-pivot/the-b-context-contenus-etape3.md §3
   (à garder identiques à src/pages/faq.astro une fois celle-ci mise à jour). */
const base = import.meta.env.BASE_URL;
const questions = [
  {
    q: "À qui s'adresse la Mission Savoir Critique ?",
    a: "Aux PME et ETI françaises dont un savoir métier critique repose sur une ou deux personnes, ou dont l'intégration de nouveaux collaborateurs prend six mois à un an.",
  },
  {
    q: "Est-ce compatible avec les IA que nous utilisons déjà ?",
    a: "Oui. Les compétences IA livrées s'injectent directement dans ChatGPT, Claude, Mistral ou tout autre assistant que vos équipes utilisent déjà. Aucun outil supplémentaire à déployer.",
  },
  {
    q: "Que reste-t-il après votre départ ?",
    a: "Le document pivot et les compétences IA livrées : relisables, transmissibles, indépendants du modèle utilisé. C'est un actif qui appartient à votre organisation, pas un outil qui dépend de nous.",
  },
];
---
<section id="faq-teaser" aria-labelledby="faq-teaser-title" class="py-20">
  <div class="max-w-3xl mx-auto px-6">
    <h2 id="faq-teaser-title" class="text-3xl font-bold text-slate-900 mb-8">Questions fréquentes</h2>
    <div class="divide-y divide-slate-200 border-y border-slate-200">
      {questions.map(({ q, a }) => (
        <details class="py-4">
          <summary class="font-medium text-slate-900 cursor-pointer">{q}</summary>
          <p class="mt-3 text-slate-600 leading-relaxed">{a}</p>
        </details>
      ))}
    </div>
    <a href={`${base}faq/`} class="inline-block mt-6 text-primary-600 font-medium hover:text-primary-700">Voir toutes les questions →</a>
  </div>
</section>
