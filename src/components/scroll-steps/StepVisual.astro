---
/* Visuel placeholder d'une étape : formes géométriques simples, décoratives (aria-hidden côté parent).
   À remplacer par de vrais visuels produit plus tard, sans toucher à la mécanique de ScrollSteps. */
export type StepVisualKind = 'scatter' | 'grid' | 'document' | 'lock' | 'network';

interface Props {
  kind: StepVisualKind;
  index: number;
}
const { kind, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---
<svg class="step-visual" viewBox="0 0 240 180" role="presentation" focusable="false">
  <text x="16" y="28" class="step-visual-num">{number}</text>

  {kind === 'scatter' && (
    <g>
      <circle cx="70" cy="80" r="7" class="fill-muted" />
      <circle cx="120" cy="60" r="5" class="fill-muted" />
      <circle cx="160" cy="95" r="9" class="fill-muted" />
      <circle cx="95" cy="125" r="6" class="fill-muted" />
      <circle cx="175" cy="140" r="4" class="fill-muted" />
      <circle cx="55" cy="140" r="5" class="fill-muted" />
      <circle cx="140" cy="125" r="3" class="fill-muted" />
      <circle cx="120" cy="95" r="22" class="stroke-accent" stroke-dasharray="4 5" />
    </g>
  )}

  {kind === 'grid' && (
    <g>
      {[0, 1, 2].map((col) => [0, 1].map((row) => (
        <rect x={62 + col * 42} y={62 + row * 42} width="32" height="32" rx="4" class={row === 0 && col === 0 ? 'fill-primary' : 'stroke-primary'} />
      )))}
    </g>
  )}

  {kind === 'document' && (
    <g>
      <rect x="80" y="40" width="80" height="110" rx="6" class="stroke-strong" />
      <line x1="94" y1="64" x2="146" y2="64" class="stroke-muted" />
      <line x1="94" y1="80" x2="146" y2="80" class="stroke-muted" />
      <line x1="94" y1="96" x2="132" y2="96" class="stroke-muted" />
      <circle cx="152" cy="138" r="16" class="fill-primary" />
      <path d="M144 138 l6 6 l10 -12" class="stroke-white" />
    </g>
  )}

  {kind === 'lock' && (
    <g>
      <path d="M96 88 V68 a24 24 0 0 1 48 0 V88" class="stroke-strong stroke-thick" />
      <rect x="78" y="88" width="84" height="66" rx="8" class="fill-primary" />
      <circle cx="120" cy="114" r="8" class="fill-white" />
      <rect x="116.5" y="118" width="7" height="18" rx="3" class="fill-white" />
    </g>
  )}

  {kind === 'network' && (
    <g>
      <line x1="120" y1="95" x2="60" y2="55" class="stroke-muted" />
      <line x1="120" y1="95" x2="180" y2="55" class="stroke-muted" />
      <line x1="120" y1="95" x2="120" y2="155" class="stroke-muted" />
      <circle cx="60" cy="55" r="12" class="stroke-strong" />
      <circle cx="180" cy="55" r="12" class="stroke-strong" />
      <circle cx="120" cy="155" r="12" class="stroke-strong" />
      <circle cx="120" cy="95" r="20" class="fill-primary" />
    </g>
  )}
</svg>

<style>
  .step-visual { width: 100%; height: 100%; display: block; }
  .step-visual-num { font: 600 14px 'Inter Variable', sans-serif; fill: #94a3b8; letter-spacing: 0.05em; }
  .fill-muted    { fill: #cbd5e1; }
  .fill-primary  { fill: var(--primary-600); }
  .fill-white    { fill: white; }
  .stroke-muted, .stroke-strong, .stroke-primary, .stroke-accent, .stroke-white { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .stroke-muted   { stroke: #cbd5e1; }
  .stroke-strong  { stroke: var(--slate-900); }
  .stroke-primary { stroke: var(--primary-600); }
  .stroke-accent  { stroke: var(--accent-500); }
  .stroke-white   { stroke: white; stroke-width: 3; }
  .stroke-thick   { stroke-width: 8; }
</style>
